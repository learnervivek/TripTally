# Server Port
PORT=5001
NODE_ENV=development

# Client URL (for CORS with credentials)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/triptally?retryWrites=true&w=majority

# JWT Secret & Expiry
JWT_SECRET=supersecret_triptally_dev_key_change_in_production
JWT_EXPIRES_IN=7d

# Cloudinary Credentials (Optional in local dev - falls back to local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
